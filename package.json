		"zod": "4.4.3"
	},
	"devDependencies": {
		"@commitlint/cli": "21.0.1",
		"@commitlint/types": "21.0.1",
		"@release-it/conventional-changelog": "11.0.0",
		"@stylistic/eslint-plugin": "5.10.0",
		"@sveltejs/kit": "2.60.1",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@types/node": "25.9.1",
		"@typescript-eslint/parser": "8.59.4",
		"eslint": "10.4.0",
		"eslint-plugin-import-x": "4.16.2",
		"eslint-plugin-perfectionist": "5.9.0",
		"eslint-plugin-svelte": "3.17.1",
		"eslint-plugin-unused-imports": "4.4.1",
		"expect": "30.4.1",
		"jiti": "2.7.0",
		"postcss-html": "1.8.1",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "3.5.2",
		"release-it": "20.0.1",
		"sass-embedded": "1.99.0",
		"stylelint": "17.12.0",
		"stylelint-order": "8.1.1",
		"svelte": "5.55.9",
		"svelte-check": "4.4.8",
		"svelte-eslint-parser": "1.6.1",
		"testcontainers": "12.0.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.59.4",
		"vite": "8.0.13"
	},
	"engines": {
		"node": ">=24.14.0",
		"npm": ">=11.9.0"
	},
	"homepage": "https://github.com/native-typescript/template-of-sveltekit-application#readme",
	"name": "@native-typescript/template-of-sveltekit-application",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/native-typescript/template-of-sveltekit-application.git"
	},
	"scripts": {
		"commitlint:check:last": "commitlint --last --strict",
		"commitlint:check:range": "commitlint --strict",
		"eslint:check": "svelte-kit sync && eslint --max-warnings=0 .",
		"eslint:fix": "svelte-kit sync && eslint --fix --max-warnings=0 .",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"release-it": "release-it --config='./release-it.config.ts'",
		"start:development": "vite dev --configLoader=native",
		"stylelint:check": "stylelint '**/*.{css,scss,svelte}' --max-warnings=0",
		"stylelint:fix": "stylelint '**/*.{css,scss,svelte}' --fix --max-warnings=0",
		"sveltekit:check": "svelte-kit sync && svelte-check --fail-on-warnings --tsconfig='./tsconfig.json'",
		"test:check": "node --experimental-test-coverage --test --test-concurrency=1 --test-coverage-exclude='**/*.test.*' --test-coverage-exclude='node_modules/**/*' --test-coverage-exclude='testing/**/*' --test-coverage-include='source/**/*' --test-global-setup='./testing/entrypoint-of-testing.ts' '**/*.test.ts'",
		"test:check:integration": "node --test --test-concurrency=1 --test-global-setup='./testing/entrypoint-of-testing.ts' '**/*.integration.test.ts'",
		"test:check:unit": "node --test --test-global-setup='./testing/entrypoint-of-testing.ts' '**/*.unit.test.ts'"
	},
	"type": "module",
	"version": "4.0.0"
}
